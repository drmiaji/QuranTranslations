    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003eوقوله : \u003cspan class=\"arabic qpc-hafs\"\u003e( وأن أتلو القرآن )\u003c/span\u003e أي : على الناس أبلغهم إياه ،\u003cspan class=\"blue\"\u003e كقوله :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( ذلك نتلوه عليك من الآيات والذكر الحكيم )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ آل عمران : 58 ]\u003c/span\u003e ،\u003cspan class=\"blue\"\u003e وكقوله :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( نتلو عليك من نبإ موسى وفرعون بالحق لقوم يؤمنون )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ القصص : 3 ]\u003c/span\u003e أي : أنا مبلغ ومنذر ، \u003cspan class=\"arabic qpc-hafs\"\u003e( فمن اهتدى فإنما يهتدي لنفسه ومن ضل فقل إنما أنا من المنذرين )\u003c/span\u003e أي : لي سوية الرسل الذين أنذروا قومهم ، وقاموا بما عليهم من أداء الرسالة إليهم ، وخلصوا من عهدتهم ، وحساب أممهم على الله ،\u003cspan class=\"blue\"\u003e كقوله تعالى :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( فإنما عليك البلاغ وعلينا الحساب )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ الرعد : 40 ]\u003c/span\u003e ،\u003cspan class=\"blue\"\u003e وقال :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( إنما أنت نذير والله على كل شيء وكيل )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ هود : 12 ]\u003c/span\u003e .\u003c/p\u003e"
}
