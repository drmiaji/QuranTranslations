    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003e\u003cspan class=\"arabic qpc-hafs\"\u003e( قل )\u003c/span\u003e يا محمد \u003cspan class=\"arabic qpc-hafs\"\u003e( عسى أن يكون ردف لكم بعض الذي تستعجلون )\u003c/span\u003e . \u003cspan class=\"reference brown\"\u003e[ قال ابن عباس أن يكون قرب -\u003cspan class=\"blue\"\u003e أو :\u003c/span\u003e أن يقرب - لكم بعض الذي تستعجلون ]\u003c/span\u003e . وهكذا قال مجاهد ، والضحاك ، وعطاء الخراساني ، وقتادة ، والسدي .\u003c/p\u003e\u003cp lang=\"ar\" class=\"ar \"\u003eوهذا هو المراد بقوله تعالى : \u003cspan class=\"arabic qpc-hafs\"\u003e( ويقولون متى هو قل عسى أن يكون قريبا )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ الإسراء : 51 ]\u003c/span\u003e ، وقال تعالى \u003cspan class=\"arabic qpc-hafs\"\u003e( يستعجلونك بالعذاب وإن جهنم لمحيطة بالكافرين )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ العنكبوت : 54 ]\u003c/span\u003e .\u003c/p\u003e\u003cp lang=\"ar\" class=\"ar \"\u003eوإنما دخلت \u003cspan class=\"red\"\u003e\" اللام \"\u003c/span\u003e في قوله : \u003cspan class=\"arabic qpc-hafs\"\u003e( ردف لكم )\u003c/span\u003e ; لأنه ضمن معنى \u003cspan class=\"red\"\u003e\" عجل لكم \"\u003c/span\u003e كما قال مجاهد في رواية عنه : \u003cspan class=\"arabic qpc-hafs\"\u003e( عسى أن يكون ردف لكم )\u003c/span\u003e : عجل لكم .\u003c/p\u003e"
}
