    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003eوقوله : \u003cspan class=\"arabic qpc-hafs\"\u003e( وإنك لتلقى القرآن من لدن حكيم عليم )\u003c/span\u003e أي : \u003cspan class=\"arabic qpc-hafs\"\u003e( وإنك )\u003c/span\u003e يا محمد -\u003cspan class=\"blue\"\u003e قال قتادة :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( لتلقى )\u003c/span\u003e أي : لتأخذ . \u003cspan class=\"arabic qpc-hafs\"\u003e( القرآن من لدن حكيم عليم )\u003c/span\u003e أي : من عند حكيم عليم ،\u003cspan class=\"blue\"\u003e أي :\u003c/span\u003e حكيم في أوامره ونواهيه ، عليم بالأمور جليلها وحقيرها ، فخبره هو الصدق المحض ، وحكمه هو العدل التام ،\u003cspan class=\"blue\"\u003e كما قال تعالى :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( وتمت كلمة ربك صدقا وعدلا )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ لا مبدل لكلماته ]\u003c/span\u003e ) \u003cspan class=\"reference brown\"\u003e[ الأنعام : 115 ]\u003c/span\u003e .\u003c/p\u003e"
}
