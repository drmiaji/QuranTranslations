    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003eثم بين تعالى حال السعداء والأشقياء يومئذ فقال : \u003cspan class=\"arabic qpc-hafs\"\u003e( من جاء بالحسنة فله خير منها )\u003c/span\u003e -\u003cspan class=\"blue\"\u003e قال قتادة :\u003c/span\u003e بالإخلاص .\u003cspan class=\"blue\"\u003e وقال زين العابدين :\u003c/span\u003e هي لا إله إلا الله - وقد بين في المكان الآخر أن له عشر أمثالها \u003cspan class=\"arabic qpc-hafs\"\u003e( وهم من فزع يومئذ آمنون )\u003c/span\u003e ،\u003cspan class=\"blue\"\u003e كما قال في الآية الأخرى :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( لا يحزنهم الفزع الأكبر )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ الأنبياء : 103 ]\u003c/span\u003e ،\u003cspan class=\"blue\"\u003e وقال :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( أفمن يلقى في النار خير أم من يأتي آمنا يوم القيامة )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ فصلت : 40 ]\u003c/span\u003e ،\u003cspan class=\"blue\"\u003e وقال :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( وهم في الغرفات آمنون )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ سبأ : 37 ]\u003c/span\u003e .\u003c/p\u003e"
}
