    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003e\u003cspan class=\"arabic qpc-hafs\"\u003e( يؤفك عنه من أفك )\u003c/span\u003e أي : إنما يروج على من هو ضال في نفسه ; لأنه قول باطل إنما ينقاد له ويضل بسببه ويؤفك عنه من هو مأفوك ضال غمر ، لا فهم له ،\u003cspan class=\"blue\"\u003e كما قال تعالى :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( فإنكم وما تعبدون ما أنتم عليه بفاتنين إلا من هو صال الجحيم )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ الصافات : 161 - 163 ]\u003c/span\u003e .\u003c/p\u003e\u003cp lang=\"ar\" class=\"ar \"\u003eقال ابن عباس ،\u003cspan class=\"blue\"\u003e والسدي :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( يؤفك عنه من أفك )\u003c/span\u003e : يضل عنه من ضل .\u003cspan class=\"blue\"\u003e وقال مجاهد :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( يؤفك عنه من أفك )\u003c/span\u003e يؤفن عنه من أفن .\u003cspan class=\"blue\"\u003e وقال الحسن البصري :\u003c/span\u003e يصرف عن هذا القرآن من كذب به .\u003c/p\u003e"
}
