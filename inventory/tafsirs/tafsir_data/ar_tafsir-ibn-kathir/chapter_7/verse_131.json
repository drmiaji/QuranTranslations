    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003e\u003cspan class=\"red\"\u003e\"فإذا جاءتهم الحسنة\"\u003c/span\u003e أي : من الخصب والرزق \u003cspan class=\"arabic qpc-hafs\"\u003e( قالوا لنا هذه )\u003c/span\u003e أي : هذا لنا بما نستحقه : ، \u003cspan class=\"arabic qpc-hafs\"\u003e( وإن تصبهم سيئة )\u003c/span\u003e أي : جدب وقحط \u003cspan class=\"arabic qpc-hafs\"\u003e( يطيروا بموسى ومن معه )\u003c/span\u003e أي : هذا بسببهم وما جاءوا به .\u003c/p\u003e\u003cp\u003e\u003cspan class=\"arabic qpc-hafs\"\u003e( ألا إنما طائرهم عند الله )\u003c/span\u003e قال علي بن أبي طلحة ،\u003cspan class=\"blue\"\u003e عن ابن عباس :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( ألا إنما طائرهم عند الله )\u003c/span\u003e يقول : مصائبهم عند الله ،\u003cspan class=\"blue\"\u003e قال الله :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( ولكن أكثرهم لا يعلمون )\u003c/span\u003e\u003c/p\u003e\u003cp\u003eوقال ابن جريج ،\u003cspan class=\"blue\"\u003e عن ابن عباس قال :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( ألا إنما طائرهم عند الله )\u003c/span\u003e قال : إلا من قبل الله .\u003c/p\u003e"
}
