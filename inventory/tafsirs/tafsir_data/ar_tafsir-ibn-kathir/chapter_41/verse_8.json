    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003eثم قال بعد ذلك : \u003cspan class=\"arabic qpc-hafs\"\u003e( إن الذين آمنوا وعملوا الصالحات لهم أجر غير ممنون )\u003c/span\u003e قال مجاهد وغيره : لا مقطوع ولا مجبوب ،\u003cspan class=\"blue\"\u003e كقوله :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( ماكثين فيه أبدا )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ الكهف : 3 ]\u003c/span\u003e ، وكقوله تعالى \u003cspan class=\"arabic qpc-hafs\"\u003e( عطاء غير مجذوذ )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ هود : 108 ]\u003c/span\u003e .\u003c/p\u003e\u003cp lang=\"ar\" class=\"ar \"\u003eوقال السدي : غير ممنون عليهم . وقد رد عليه بعض الأئمة هذا التفسير ،\u003cspan class=\"blue\"\u003e فإن المنة لله على أهل الجنة ; قال الله تعالى :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( بل الله يمن عليكم أن هداكم للإيمان )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ الحجرات : 17 ]\u003c/span\u003e ،\u003cspan class=\"blue\"\u003e وقال أهل الجنة :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( فمن الله علينا ووقانا عذاب السموم )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ الطور : 27 ]\u003c/span\u003e ، وقال رسول الله - صلى الله عليه وسلم -\u003cspan class=\"blue\"\u003e :\u003c/span\u003e \u003cspan class=\"red\"\u003e\" إلا أن يتغمدني الله برحمة منه وفضل \"\u003c/span\u003e .\u003c/p\u003e"
}
