    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003eثم قال : \u003cspan class=\"arabic qpc-hafs\"\u003e( وإذا أنعمنا على الإنسان أعرض ونأى بجانبه )\u003c/span\u003e أي : أعرض عن الطاعة ، واستكبر عن الانقياد لأوامر الله ، عز وجل ،\u003cspan class=\"blue\"\u003e كقوله تعالى :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( فتولى بركنه )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ الذاريات : 39 ]\u003c/span\u003e .\u003c/p\u003e\u003cp lang=\"ar\" class=\"ar \"\u003e\u003cspan class=\"arabic qpc-hafs\"\u003e( وإذا مسه الشر )\u003c/span\u003e أي : الشدة ، \u003cspan class=\"arabic qpc-hafs\"\u003e( فذو دعاء عريض )\u003c/span\u003e أي : يطيل المسألة في الشيء الواحد فالكلام العريض : ما طال لفظه وقل معناه ،\u003cspan class=\"blue\"\u003e والوجيز :\u003c/span\u003e عكسه ،\u003cspan class=\"blue\"\u003e وهو :\u003c/span\u003e ما قل ودل .\u003cspan class=\"blue\"\u003e وقد قال تعالى :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( وإذا مس الإنسان الضر دعانا لجنبه أو قاعدا أو قائما فلما كشفنا عنه ضره مر كأن لم يدعنا إلى ضر مسه )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ يونس : 12 ]\u003c/span\u003e .\u003c/p\u003e"
}
