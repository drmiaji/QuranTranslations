    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003eوقال العوفي ،\u003cspan class=\"blue\"\u003e عن ابن عباس :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( بأيكم المفتون )\u003c/span\u003e أي : الجنون . وكذا قال مجاهد وغيره .\u003cspan class=\"blue\"\u003e وقال قتادة وغيره :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( بأيكم المفتون )\u003c/span\u003e أي : أولى بالشيطان .\u003c/p\u003e\u003cp lang=\"ar\" class=\"ar \"\u003eومعنى المفتون ظاهر ،\u003cspan class=\"blue\"\u003e أي :\u003c/span\u003e الذي قد افتتن عن الحق وضل عنه ،\u003cspan class=\"blue\"\u003e وإنما دخلت الباء في قوله :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( بأيكم المفتون )\u003c/span\u003e لتدل على تضمين الفعل في قوله : \u003cspan class=\"arabic qpc-hafs\"\u003e( فستبصر ويبصرون )\u003c/span\u003e وتقديره : فستعلم ويعلمون ،\u003cspan class=\"blue\"\u003e أو :\u003c/span\u003e فستخبر ويخبرون بأيكم المفتون . والله أعلم .\u003c/p\u003e"
}
