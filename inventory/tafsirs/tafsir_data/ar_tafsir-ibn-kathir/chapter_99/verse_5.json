    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003eوقوله : \u003cspan class=\"arabic qpc-hafs\"\u003e( بأن ربك أوحى لها )\u003c/span\u003e قال البخاري : أوحى لها وأوحى إليها ،\u003cspan class=\"blue\"\u003e ووحى لها ووحى إليها :\u003c/span\u003e واحد وكذا قال ابن عباس : \u003cspan class=\"arabic qpc-hafs\"\u003e( أوحى لها )\u003c/span\u003e أي : أوحى إليها .\u003c/p\u003e\u003cp\u003eوالظاهر أن هذا مضمن \u003cspan class=\"reference brown\"\u003e[ بمعنى ]\u003c/span\u003e أذن لها .\u003c/p\u003e\u003cp lang=\"ar\" class=\"ar \"\u003eوقال شبيب بن بشر ،\u003cspan class=\"blue\"\u003e عن عكرمة عن ابن عباس :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( يومئذ تحدث أخبارها )\u003c/span\u003e قال : قال لها ربها : قولي ، فقالت .\u003c/p\u003e\u003cp\u003eوقال مجاهد : \u003cspan class=\"arabic qpc-hafs\"\u003e( أوحى لها )\u003c/span\u003e أي : أمرها .\u003cspan class=\"blue\"\u003e وقال القرظي :\u003c/span\u003e أمرها أن تنشق عنهم .\u003c/p\u003e"
}
