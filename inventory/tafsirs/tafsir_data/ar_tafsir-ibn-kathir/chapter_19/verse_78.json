    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003eوقوله : \u003cspan class=\"arabic qpc-hafs\"\u003e( أطلع الغيب )\u003c/span\u003e : إنكار على هذا القائل ، \u003cspan class=\"arabic qpc-hafs\"\u003e( لأوتين مالا وولدا )\u003c/span\u003e يعني : يوم القيامة ،\u003cspan class=\"blue\"\u003e أي :\u003c/span\u003e أعلم ما له في الآخرة حتى تألى وحلف على ذلك ، \u003cspan class=\"arabic qpc-hafs\"\u003e( أم اتخذ عند الرحمن عهدا )\u003c/span\u003e : أم له عند الله عهد سيؤتيه ذلك ؟\u003cspan class=\"blue\"\u003e وقد تقدم عند البخاري :\u003c/span\u003e أنه الموثق .\u003c/p\u003e\u003cp lang=\"ar\" class=\"ar \"\u003eوقال الضحاك ،\u003cspan class=\"blue\"\u003e عن ابن عباس :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( أطلع الغيب أم اتخذ عند الرحمن عهدا )\u003c/span\u003e قال : لا إله إلا الله ، فيرجو بها .\u003cspan class=\"blue\"\u003e وقال محمد بن كعب القرظي :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( أم اتخذ عند الرحمن عهدا )\u003c/span\u003e قال : شهادة أن لا إله إلا الله ،\u003cspan class=\"blue\"\u003e ثم قرأ :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( أم اتخذ عند الرحمن عهدا )\u003c/span\u003e .\u003c/p\u003e"
}
