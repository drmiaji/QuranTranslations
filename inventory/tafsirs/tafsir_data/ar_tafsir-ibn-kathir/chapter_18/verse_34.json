    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003e\u003cspan class=\"arabic qpc-hafs\"\u003e( وكان له ثمر )\u003c/span\u003e قيل : المراد به : المال . روي عن ابن عباس ، ومجاهد ، وقتادة .\u003cspan class=\"blue\"\u003e وقيل :\u003c/span\u003e الثمار وهو أظهر هاهنا ،\u003cspan class=\"blue\"\u003e ويؤيده القراءة الأخرى :\u003c/span\u003e \u003cspan class=\"red\"\u003e\" وكان له ثمر \"\u003c/span\u003e بضم الثاء وتسكين الميم ، فيكون جمع ثمرة ، كخشبة وخشب ،\u003cspan class=\"blue\"\u003e وقرأ آخرون :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( ثمر )\u003c/span\u003e بفتح الثاء والميم .\u003c/p\u003e\u003cp lang=\"ar\" class=\"ar \"\u003eفقال - أي صاحب هاتين \u003cspan class=\"reference brown\"\u003e[ الجنتين ]\u003c/span\u003e - \u003cspan class=\"arabic qpc-hafs\"\u003e( لصاحبه وهو يحاوره )\u003c/span\u003e أي : يجادله ويخاصمه ،\u003cspan class=\"blue\"\u003e يفتخر عليه ويترأس :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( أنا أكثر منك مالا وأعز نفرا )\u003c/span\u003e أي أكثر خدما وحشما وولدا .\u003c/p\u003e\u003cp\u003eقال قتادة : تلك - والله -\u003cspan class=\"blue\"\u003e أمنية الفاجر :\u003c/span\u003e كثرة المال وعزة النفر .\u003c/p\u003e"
}
