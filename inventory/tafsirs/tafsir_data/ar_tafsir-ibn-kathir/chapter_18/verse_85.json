    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003eقال ابن عباس : \u003cspan class=\"arabic qpc-hafs\"\u003e( فأتبع سببا )\u003c/span\u003e يعني : بالسبب المنزل ] .\u003cspan class=\"blue\"\u003e وقال مجاهد :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( فأتبع سببا )\u003c/span\u003e : منزلا وطريقا ما بين المشرق والمغرب .\u003c/p\u003e\u003cp\u003eوفي رواية عن مجاهد : \u003cspan class=\"arabic qpc-hafs\"\u003e( سببا )\u003c/span\u003e قال : طريقا في الأرض .\u003c/p\u003e\u003cp\u003eوقال قتادة : أي أتبع منازل الأرض ومعالمها .\u003c/p\u003e\u003cp\u003eوقال الضحاك : \u003cspan class=\"arabic qpc-hafs\"\u003e( فأتبع سببا )\u003c/span\u003e أي المنازل .\u003c/p\u003e\u003cp lang=\"ar\" class=\"ar \"\u003eوقال سعيد بن جبير في قوله : \u003cspan class=\"arabic qpc-hafs\"\u003e( فأتبع سببا )\u003c/span\u003e قال : علما . وهكذا قال عكرمة وعبيد بن يعلى ، والسدي .\u003c/p\u003e\u003cp\u003eوقال مطر : معالم وآثار كانت قبل ذلك .\u003c/p\u003e"
}
