    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003e\u003cspan class=\"arabic qpc-hafs\"\u003e( تظن )\u003c/span\u003e أي : تستيقن ، \u003cspan class=\"arabic qpc-hafs\"\u003e( أن يفعل بها فاقرة )\u003c/span\u003e قال مجاهد : داهية .\u003cspan class=\"blue\"\u003e وقال قتادة :\u003c/span\u003e شر .\u003cspan class=\"blue\"\u003e وقال السدي :\u003c/span\u003e تستيقن أنها هالكة .\u003cspan class=\"blue\"\u003e وقال ابن زيد :\u003c/span\u003e تظن أن ستدخل النار .\u003c/p\u003e\u003cp lang=\"ar\" class=\"ar \"\u003eوهذا المقام كقوله : \u003cspan class=\"arabic qpc-hafs\"\u003e( يوم تبيض وجوه وتسود وجوه )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ آل عمران : 106 ]\u003c/span\u003e وكقوله \u003cspan class=\"arabic qpc-hafs\"\u003e( وجوه يومئذ مسفرة ضاحكة مستبشرة ووجوه يومئذ عليها غبرة ترهقها قترة أولئك هم الكفرة الفجرة )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ عبس : 38 - 42 ]\u003c/span\u003e وكقوله \u003cspan class=\"arabic qpc-hafs\"\u003e( وجوه يومئذ خاشعة عاملة ناصبة تصلى نارا حامية )\u003c/span\u003e إلى قوله : \u003cspan class=\"arabic qpc-hafs\"\u003e( وجوه يومئذ ناعمة لسعيها راضية في جنة عالية )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ الغاشية : 2 - 10 ]\u003c/span\u003e في أشباه ذلك من الآيات والسياقات .\u003c/p\u003e"
}
