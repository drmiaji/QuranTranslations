    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003eولهذا قال : تعالى \u003cspan class=\"arabic qpc-hafs\"\u003e( فعصوا رسول ربهم )\u003c/span\u003e وهذا جنس ،\u003cspan class=\"blue\"\u003e أي :\u003c/span\u003e كل كذب رسول الله إليهم .\u003cspan class=\"blue\"\u003e كما قال :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( كل كذب الرسل فحق وعيد )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ ق : 14 ]\u003c/span\u003e . ومن كذب رسول الله فقد كذب بالجميع ،\u003cspan class=\"blue\"\u003e كما قال :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( كذبت قوم نوح المرسلين )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ الشعراء : 105 ]\u003c/span\u003e ، \u003cspan class=\"arabic qpc-hafs\"\u003e( كذبت عاد المرسلين )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ الشعراء : 123 ]\u003c/span\u003e . \u003cspan class=\"arabic qpc-hafs\"\u003e( كذبت ثمود المرسلين )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ الشعراء : 141 ]\u003c/span\u003e وإنما جاء إلى كل أمة رسول واحد ; ولهذا قال ها هنا : \u003cspan class=\"arabic qpc-hafs\"\u003e( فعصوا رسول ربهم فأخذهم أخذة رابية )\u003c/span\u003e أي : عظيمة شديدة أليمة .\u003c/p\u003e\u003cp\u003eقال مجاهد : \u003cspan class=\"arabic qpc-hafs\"\u003e( رابية )\u003c/span\u003e شديدة .\u003cspan class=\"blue\"\u003e وقال السدي :\u003c/span\u003e مهلكة .\u003c/p\u003e"
}
