    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003eولهذا قال تعالى : \u003cspan class=\"arabic qpc-hafs\"\u003e( فنبذناه )\u003c/span\u003e أي : ألقيناه ) بالعراء ) قال ابن عباس ،\u003cspan class=\"blue\"\u003e وغيره :\u003c/span\u003e وهي الأرض التي ليس بها نبت ولا بناء .\u003cspan class=\"blue\"\u003e قيل :\u003c/span\u003e على جانب دجلة .\u003cspan class=\"blue\"\u003e وقيل :\u003c/span\u003e بأرض اليمن . فالله أعلم .\u003c/p\u003e\u003cp lang=\"ar\" class=\"ar \"\u003e\u003cspan class=\"arabic qpc-hafs\"\u003e( وهو سقيم )\u003c/span\u003e أي : ضعيف البدن . قال ابن مسعود ،\u003cspan class=\"blue\"\u003e رضي الله عنه :\u003c/span\u003e كهيئة الفرخ ليس عليه ريش .\u003cspan class=\"blue\"\u003e وقال السدي :\u003c/span\u003e كهيئة الصبي : حين يولد ، وهو المنفوس . وقاله ابن عباس ، وابن زيد أيضا .\u003c/p\u003e"
}
