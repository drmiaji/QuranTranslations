    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003eيقول تعالى مخاطبا لأهل مكة من مشركي قريش ،\u003cspan class=\"blue\"\u003e ومن دان بدينهم من عبدة الأصنام والأوثان :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( إنكم وما تعبدون من دون الله حصب جهنم )\u003c/span\u003e ،\u003cspan class=\"blue\"\u003e قال ابن عباس :\u003c/span\u003e أي وقودها ،\u003cspan class=\"blue\"\u003e يعني كقوله :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( وقودها الناس والحجارة )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ التحريم : 6 ]\u003c/span\u003e .\u003c/p\u003e\u003cp\u003eوقال ابن عباس أيضا : \u003cspan class=\"arabic qpc-hafs\"\u003e( حصب جهنم )\u003c/span\u003e بمعنى : شجر جهنم .\u003cspan class=\"blue\"\u003e وفي رواية قال :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( حصب جهنم )\u003c/span\u003e يعني : حطب جهنم ، بالزنجية .\u003c/p\u003e\u003cp\u003eوقال مجاهد ، وعكرمة ،\u003cspan class=\"blue\"\u003e وقتادة :\u003c/span\u003e حطبها . وهي كذلك في قراءة علي وعائشة - رضي الله عنهما .\u003c/p\u003e\u003cp\u003eوقال الضحاك : \u003cspan class=\"arabic qpc-hafs\"\u003e( حصب جهنم )\u003c/span\u003e أي : ما يرمى به فيها .\u003c/p\u003e\u003cp\u003eوكذا قال غيره . والجميع قريب .\u003c/p\u003e\u003cp\u003eوقوله : \u003cspan class=\"arabic qpc-hafs\"\u003e( أنتم لها واردون )\u003c/span\u003e أي : داخلون .\u003c/p\u003e"
}
