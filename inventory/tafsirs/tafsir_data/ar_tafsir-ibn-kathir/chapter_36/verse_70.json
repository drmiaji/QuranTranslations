    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003e\u003cspan class=\"arabic qpc-hafs\"\u003e( لينذر من كان حيا )\u003c/span\u003e أي : لينذر هذا القرآن البين كل حي على وجه الأرض ،\u003cspan class=\"blue\"\u003e كقوله :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( لأنذركم به ومن بلغ )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ الأنعام : 19 ]\u003c/span\u003e ،\u003cspan class=\"blue\"\u003e وقال :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( ومن يكفر به من الأحزاب فالنار موعده )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ هود : 17 ]\u003c/span\u003e . وإنما ينتفع بنذارته من هو حي القلب ، مستنير البصيرة ،\u003cspan class=\"blue\"\u003e كما قال قتادة :\u003c/span\u003e حي القلب ، حي البصر .\u003cspan class=\"blue\"\u003e وقال الضحاك :\u003c/span\u003e يعني : عاقلا \u003cspan class=\"arabic qpc-hafs\"\u003e( ويحق القول على الكافرين )\u003c/span\u003e أي : هو رحمة للمؤمن ، وحجة على الكافر .\u003c/p\u003e"
}
