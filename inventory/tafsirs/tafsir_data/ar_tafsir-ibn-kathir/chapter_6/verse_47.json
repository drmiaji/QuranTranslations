    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003eوقوله : \u003cspan class=\"arabic qpc-hafs\"\u003e( قل أرأيتكم إن أتاكم عذاب الله بغتة )\u003c/span\u003e أي : وأنتم لا تشعرون به حتى بغتكم وفجأكم .\u003c/p\u003e\u003cp lang=\"ar\" class=\"ar \"\u003e\u003cspan class=\"arabic qpc-hafs\"\u003e( أو جهرة )\u003c/span\u003e أي : ظاهرا عيانا \u003cspan class=\"arabic qpc-hafs\"\u003e( هل يهلك إلا القوم الظالمون )\u003c/span\u003e أي : إنما : كان يحيط بالظالمين أنفسهم بالشرك بالله \u003cspan class=\"reference brown\"\u003e[ عز وجل ]\u003c/span\u003e وينجو الذين كانوا يعبدون الله وحده لا شريك له ، فلا خوف عليهم ولا هم يحزنون . كما قال تعالى \u003cspan class=\"arabic qpc-hafs\"\u003e( الذين آمنوا ولم يلبسوا إيمانهم بظلم \u003cspan class=\"reference brown\"\u003e[ أولئك لهم الأمن وهم مهتدون ]\u003c/span\u003e )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ الأنعام : 82 ]\u003c/span\u003e . .\u003c/p\u003e"
}
