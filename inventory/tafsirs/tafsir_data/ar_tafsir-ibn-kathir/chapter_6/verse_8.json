    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003e\u003cspan class=\"arabic qpc-hafs\"\u003e( وقالوا لولا أنزل عليه ملك )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ أي : فيكون معه نذيرا ]\u003c/span\u003e قال الله : \u003cspan class=\"arabic qpc-hafs\"\u003e( ولو أنزلنا ملكا لقضي الأمر ثم لا ينظرون )\u003c/span\u003e أي : لو نزلت الملائكة على ما هم عليه لجاءهم من الله العذاب ،\u003cspan class=\"blue\"\u003e كما قال تعالى :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( ما ننزل الملائكة إلا بالحق وما كانوا إذا منظرين )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ الحجر : 8 ]\u003c/span\u003e ، \u003cspan class=\"reference brown\"\u003e[ و ]\u003c/span\u003e قال تعالى : \u003cspan class=\"arabic qpc-hafs\"\u003e( يوم يرون الملائكة لا بشرى يومئذ للمجرمين \u003cspan class=\"reference brown\"\u003e[ ويقولون حجرا محجورا ]\u003c/span\u003e )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ الفرقان : 22 ]\u003c/span\u003e .\u003c/p\u003e"
}
