    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003eوقوله : \u003cspan class=\"arabic qpc-hafs\"\u003e( وإذا الرسل أقتت )\u003c/span\u003e قال العوفي ،\u003cspan class=\"blue\"\u003e عن ابن عباس :\u003c/span\u003e جمعت .\u003cspan class=\"blue\"\u003e وقال ابن زيد :\u003c/span\u003e وهذه كقوله تعالى : \u003cspan class=\"arabic qpc-hafs\"\u003e( يوم يجمع الله الرسل )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ المائدة : 109 ]\u003c/span\u003e .\u003cspan class=\"blue\"\u003e وقال مجاهد :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( أقتت )\u003c/span\u003e أجلت .\u003c/p\u003e\u003cp lang=\"ar\" class=\"ar \"\u003eوقال الثوري ، عن منصور ،\u003cspan class=\"blue\"\u003e عن إبراهيم :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( أقتت )\u003c/span\u003e أوعدت .\u003cspan class=\"blue\"\u003e وكأنه يجعلها كقوله :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( وأشرقت الأرض بنور ربها ووضع الكتاب وجيء بالنبيين والشهداء وقضي بينهم بالحق وهم لا يظلمون )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ الزمر : 69 ]\u003c/span\u003e .\u003c/p\u003e"
}
