    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003eثم قال : \u003cspan class=\"arabic qpc-hafs\"\u003e( فمهل الكافرين )\u003c/span\u003e أي : أنظرهم ولا تستعجل لهم ، \u003cspan class=\"arabic qpc-hafs\"\u003e( أمهلهم رويدا )\u003c/span\u003e أي : قليلا .\u003cspan class=\"blue\"\u003e أي :\u003c/span\u003e وترى ماذا أحل بهم من العذاب والنكال والعقوبة والهلاك ،\u003cspan class=\"blue\"\u003e كما قال :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( نمتعهم قليلا ثم نضطرهم إلى عذاب غليظ )\u003c/span\u003e \u003cspan class=\"reference brown\"\u003e[ لقمان : 24 ]\u003c/span\u003e .\u003c/p\u003e\u003cp\u003eآخر تفسير سورة \u003cspan class=\"red\"\u003e\" الطارق \"\u003c/span\u003e ولله الحمد .\u003c/p\u003e"
