    "text":  "\u003cp lang=\"ar\" class=\"ar \"\u003eوقال هناك : \u003cspan class=\"arabic qpc-hafs\"\u003e( فيهما عينان تجريان )\u003c/span\u003e ،\u003cspan class=\"blue\"\u003e وقال هاهنا :\u003c/span\u003e \u003cspan class=\"arabic qpc-hafs\"\u003e( نضاختان )\u003c/span\u003e ، وقال علي بن أبي طلحة ،\u003cspan class=\"blue\"\u003e عن ابن عباس :\u003c/span\u003e أي فياضتان . والجري أقوى من النضخ .\u003c/p\u003e\u003cp\u003eوقال الضحاك : \u003cspan class=\"arabic qpc-hafs\"\u003e( نضاختان )\u003c/span\u003e أي ممتلئتان لا تنقطعان .\u003c/p\u003e"
